    {
      "name": "Admin Broadcasts",
      "item": [
        {
          "name": "1. Admin Create Broadcast",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/{{api_prefix}}/notifications/broadcasts",
            "description": "Admin-only endpoint that creates and dispatches a broadcast notification.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman notification smoke test\",\n  \"body\": \"This notification broadcast was sent from Postman.\",\n  \"type\": \"hybrid\",\n  \"category\": \"admin_broadcast\",\n  \"audience\": {\n    \"mode\": \"customers\"\n  },\n  \"data\": {\n    \"route\": \"/notifications\",\n    \"source\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requestUrl = pm.request.url.toString();",
                  "const resolvedUrl = pm.variables.replaceIn(requestUrl);",
