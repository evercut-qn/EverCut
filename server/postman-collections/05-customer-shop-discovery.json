              "  pm.globals.set('shared_shop_id', shopId);",
              "}",
              "if (preferredService && preferredService.id) {",
              "  const serviceId = preferredService.id;",
              "  pm.collectionVariables.set('service_id', serviceId);",
              "  pm.globals.set('shared_service_id', serviceId);",
              "}"
            ]
          }
        }
      ]
    },
