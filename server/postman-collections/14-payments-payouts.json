              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Refund initiated\",\n  \"data\": {\n    \"merchantRefundId\": \"RF-EC-65f1e7a125d0dc001f2a1001-1714000000000-ab12cd34-1714000900000\",\n    \"refundId\": \"RFD123456789\",\n    \"state\": \"PENDING\",\n    \"refundAmount\": 293,\n    \"deductions\": {\n      \"refundFee\": 7,\n      \"platformFee\": 3\n    }\n  }\n}"
