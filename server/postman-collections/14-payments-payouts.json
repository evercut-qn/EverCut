  "item": [
    {
      "name": "Payments",
      "item": [
        {
          "name": "1. Initiate Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('captures payment references', function () {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.success).to.equal(true);",
                  "  pm.expect(response.data).to.have.property('paymentId');",
                  "  pm.expect(response.data).to.have.property('merchantOrderId');",
                  "  pm.collectionVariables.set('payment_id', response.data.paymentId);",
                  "  pm.collectionVariables.set('merchant_order_id', response.data.merchantOrderId);",
                  "  pm.environment.set('payment_id', response.data.paymentId);",
                  "  pm.environment.set('merchant_order_id', response.data.merchantOrderId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/{{api_prefix}}/payments/initiate",
            "description": "Creates a PhonePe checkout order for the authenticated customer's pending booking. The booking must be created first through 04-customer-bookings.json.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{payment_booking_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "Payment initiated",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{base_url}}/{{api_prefix}}/payments/initiate",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"bookingId\": \"65f1e7a125d0dc001f2a1001\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Payment initiated\",\n  \"data\": {\n    \"redirectUrl\": \"https://mercury-uat.phonepe.com/transact/pgCheckout?token=sample\",\n    \"paymentId\": \"65f1e7a125d0dc001f2a2001\",\n    \"merchantOrderId\": \"EC-65f1e7a125d0dc001f2a1001-1714000000000-ab12cd34\"\n  }\n}"
            }
          ]
        },
        {
          "name": "2. Get Payment Status",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/{{api_prefix}}/payments/{{payment_id}}/status",
            "description": "Reads payment status and polls PhonePe once when the payment is still pending."
          },
          "response": [
            {
              "name": "Payment status",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": "{{base_url}}/{{api_prefix}}/payments/{{payment_id}}/status"
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Payment status\",\n  \"data\": {\n    \"_id\": \"65f1e7a125d0dc001f2a2001\",\n    \"bookingId\": \"65f1e7a125d0dc001f2a1001\",\n    \"merchantOrderId\": \"EC-65f1e7a125d0dc001f2a1001-1714000000000-ab12cd34\",\n    \"status\": \"completed\",\n    \"amountInRupees\": 303,\n    \"paymentMode\": \"UPI_INTENT\",\n    \"createdAt\": \"2026-04-23T06:30:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "3. Get Payment By Booking",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_access_token}}",
                  "type": "string"
