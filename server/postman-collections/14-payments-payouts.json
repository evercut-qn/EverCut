{
  "info": {
    "name": "EverCut - Payments & Payouts",
    "description": "Native PhonePe SDK payment initiation/verification, status checking, refund processing, and payout retry for the EverCut dual-provider payment system. PhonePe is used for customer collection; Cashfree Payouts is used for barber disbursement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customer_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const readScopedValue = (...keys) => {",
          "  for (const key of keys) {",
          "    const environmentValue = pm.environment.get(key);",
          "    if (environmentValue) return environmentValue;",
          "    const globalValue = pm.globals.get(key);",
          "    if (globalValue) return globalValue;",
          "  }",
          "  return '';",
          "};",
          "const syncScopedValue = (sourceKey, collectionKey = sourceKey) => {",
          "  const scopedValue = readScopedValue(sourceKey);",
          "  if (scopedValue) {",
          "    pm.collectionVariables.set(collectionKey, scopedValue);",
          "  }",
          "};",
          "syncScopedValue('base_url');",
          "syncScopedValue('api_prefix');",
          "syncScopedValue('shared_booking_id', 'payment_booking_id');",
          "syncScopedValue('payment_id', 'payment_id');",
          "syncScopedValue('merchant_order_id', 'merchant_order_id');",
          "syncScopedValue('merchant_refund_id', 'merchant_refund_id');",
          "syncScopedValue('refund_id', 'refund_id');",
          "syncScopedValue('payout_id', 'payout_id');",
          "syncScopedValue('admin_access_token', 'admin_access_token');",
          "const customerToken = readScopedValue('customer_access_token');",
          "if (customerToken) { pm.collectionVariables.set('customer_access_token', customerToken); }",
          "const barberToken = readScopedValue('barber_access_token');",
          "if (barberToken) { pm.collectionVariables.set('barber_access_token', barberToken); }",
          "// Ensure payment_booking_id is set from shared_booking_id or booking_id",
          "const bookingId = readScopedValue('shared_booking_id', 'booking_id', 'payment_booking_id');",
          "if (bookingId) {",
          "  pm.collectionVariables.set('payment_booking_id', bookingId);",
          "  pm.environment.set('payment_booking_id', bookingId);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Default local API server"
    },
    {
      "key": "api_prefix",
      "value": "api/v1",
      "type": "string",
      "description": "API prefix used by every request"
    },
    {
      "key": "customer_access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token - auto-set by 01-authentication.json for returning users or by 02-onboarding.json after first-time signup"
    },
    {
      "key": "barber_access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token - auto-set by 01-authentication.json for returning users or by 02-onboarding.json after first-time signup"
    },
    {
      "key": "admin_access_token",
      "value": "",
      "type": "string",
      "description": "Required for payout retry. Use a JWT for a user whose role is ADMIN."
    },
    {
      "key": "payment_booking_id",
      "value": "",
      "type": "string",
      "description": "Booking ID for payment - auto-synced from shared_booking_id or booking_id"
    },
    {
      "key": "payment_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from payment initiation"
    },
    {
      "key": "merchant_order_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from payment initiation"
    },
    {
      "key": "merchant_refund_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from refund initiation"
    },
    {
      "key": "refund_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from refund initiation"
    },
    {
      "key": "payout_id",
      "value": "",
      "type": "string",
      "description": "Payout ID for retry operations"
    }
  ],
  "item": [
    {
      "name": "1. Create Native SDK Payment Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/payments",
        "description": "Creates a PhonePe native SDK checkout order for the authenticated customer's pending booking. The response returns orderId, token, merchantId, merchantOrderId, and paymentId for the Flutter PhonePe SDK. No redirect URL is returned.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"{{payment_booking_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('captures native payment references', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response.success).to.equal(true);",
              "  pm.expect(response.data).to.have.property('paymentId');",
              "  pm.expect(response.data).to.have.property('merchantOrderId');",
              "  pm.expect(response.data).to.have.property('orderId');",
              "  pm.expect(response.data).to.have.property('token');",
              "  pm.expect(response.data).to.have.property('merchantId');",
              "  pm.expect(response.data).to.not.have.property('redirectUrl');",
              "  pm.collectionVariables.set('payment_id', response.data.paymentId);",
              "  pm.collectionVariables.set('merchant_order_id', response.data.merchantOrderId);",
              "  pm.environment.set('payment_id', response.data.paymentId);",
              "  pm.environment.set('merchant_order_id', response.data.merchantOrderId);",
              "  pm.globals.set('payment_id', response.data.paymentId);",
              "  pm.globals.set('merchant_order_id', response.data.merchantOrderId);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get Payment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/payments/{{payment_id}}",
        "description": "Reads payment details and polls PhonePe once when the payment is still pending. Use this for manual status checks or post-failure support.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Verify Native SDK Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/payments/{{payment_id}}/verify",
        "description": "Verifies the PhonePe SDK callback with the backend. The SDK callback is informational only; this endpoint calls PhonePe Order Status and returns the authoritative state.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sdkStatus\": \"SUCCESS\",\n  \"sdkResponseCode\": \"SDK_CALLBACK\",\n  \"sdkMessage\": \"Flutter SDK callback received\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('verified response has authoritative status fields', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response.success).to.equal(true);",
              "  pm.expect(response.data).to.have.property('status');",
              "  pm.expect(response.data).to.have.property('gatewayState');",
              "  pm.expect(response.data).to.have.property('paymentStatus');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get Payment By Booking",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/bookings/{{payment_booking_id}}/payment",
        "description": "Returns the latest payment transaction for the authenticated customer's booking.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const response = pm.response.json();",
              "const data = response.data || {};",
              "if (data._id) {",
              "  pm.collectionVariables.set('payment_id', data._id);",
              "  pm.environment.set('payment_id', data._id);",
              "  pm.globals.set('payment_id', data._id);",
              "}",
              "if (data.merchantOrderId) {",
              "  pm.collectionVariables.set('merchant_order_id', data.merchantOrderId);",
              "  pm.environment.set('merchant_order_id', data.merchantOrderId);",
              "  pm.globals.set('merchant_order_id', data.merchantOrderId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Initiate Refund",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/bookings/{{payment_booking_id}}/refund",
        "description": "Initiates a refund for a completed payment when payout has not started. Allowed roles: BARBER or ADMIN.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Customer cancelled before payout batch\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{barber_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('captures refund references', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response.success).to.equal(true);",
              "  if (response.data?.merchantRefundId) {",
              "    pm.collectionVariables.set('merchant_refund_id', response.data.merchantRefundId);",
              "    pm.environment.set('merchant_refund_id', response.data.merchantRefundId);",
              "    pm.globals.set('merchant_refund_id', response.data.merchantRefundId);",
              "  }",
              "  if (response.data?.refundId) {",
              "    pm.collectionVariables.set('refund_id', response.data.refundId);",
              "    pm.environment.set('refund_id', response.data.refundId);",
              "    pm.globals.set('refund_id', response.data.refundId);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Retry Failed Payout",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/payouts/{{payout_id}}/retry",
        "description": "Retries a failed or reversed payout. Requires an ADMIN token and a payout ID from MongoDB.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('captures retry payout references when present', function () {",
              "  const response = pm.response.json();",
              "  if (response.data?._id) {",
              "    pm.collectionVariables.set('payout_id', response.data._id);",
              "    pm.environment.set('payout_id', response.data._id);",
              "    pm.globals.set('payout_id', response.data._id);",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
