                "url": "{{base_url}}/{{api_prefix}}/payments/{{payment_booking_id}}/refund",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Customer cancelled before payout batch\"\n}"
                }
