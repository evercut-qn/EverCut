{
  "info": {
    "name": "EverCut - Payments & Payouts",
    "description": "Payment collection, refund, payout retry, and webhook simulation requests for the EverCut dual-provider payment system. PhonePe is used for customer collection; Cashfree Payouts is used for barber disbursement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const readScopedValue = (...keys) => {",
          "  for (const key of keys) {",
          "    const environmentValue = pm.environment.get(key);",
          "    if (environmentValue) return environmentValue;",
          "    const collectionValue = pm.collectionVariables.get(key);",
          "    if (collectionValue) return collectionValue;",
          "    const globalValue = pm.globals.get(key);",
          "    if (globalValue) return globalValue;",
          "  }",
          "  return '';",
          "};",
          "const syncScopedValue = (sourceKey, collectionKey = sourceKey) => {",
          "  const scopedValue = readScopedValue(sourceKey);",
          "  if (scopedValue) pm.collectionVariables.set(collectionKey, scopedValue);",
          "};",
          "[",
          "  'base_url',",
          "  'api_prefix',",
          "  'customer_access_token',",
          "  'barber_access_token',",
          "  'admin_access_token',",
          "  'shared_booking_id',",
          "  'payment_booking_id',",
          "  'payment_id',",
          "  'merchant_order_id',",
          "  'merchant_refund_id',",
          "  'refund_id',",
          "  'payout_id',",
          "  'payout_transfer_id',",
          "  'gateway_transfer_id'",
          "].forEach((key) => syncScopedValue(key, key === 'shared_booking_id' ? 'payment_booking_id' : key));",
          "const phonepeUser = readScopedValue('phonepe_webhook_username') || 'test-phonepe-webhook-user';",
          "const phonepePassword = readScopedValue('phonepe_webhook_password') || 'test-phonepe-webhook-password';",
          "pm.collectionVariables.set('phonepe_webhook_authorization', CryptoJS.SHA256(`${phonepeUser}:${phonepePassword}`).toString(CryptoJS.enc.Hex));",
          "if (pm.info.requestName.includes('Cashfree')) {",
          "  const timestamp = Math.floor(Date.now() / 1000).toString();",
          "  const secret = readScopedValue('cashfree_webhook_secret') || 'test-cashfree-client-secret';",
          "  const rawBody = pm.variables.replaceIn(pm.request.body?.raw || '');",
          "  const hmac = CryptoJS.HmacSHA256(`${timestamp}${rawBody}`, secret);",
          "  pm.collectionVariables.set('cashfree_webhook_timestamp', timestamp);",
          "  pm.collectionVariables.set('cashfree_webhook_signature', CryptoJS.enc.Base64.stringify(hmac));",
          "}"
        ]
      }
    }
  ],
  "variable": [
