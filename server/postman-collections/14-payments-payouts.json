    {
      "name": "Payouts",
      "item": [
        {
          "name": "6. Retry Failed Payout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('captures retry payout references when present', function () {",
                  "  const response = pm.response.json();",
                  "  if (response.data?._id) pm.collectionVariables.set('payout_id', response.data._id);",
                  "  if (response.data?.transferId) pm.collectionVariables.set('payout_transfer_id', response.data.transferId);",
                  "  if (response.data?.gatewayTransferId) pm.collectionVariables.set('gateway_transfer_id', response.data.gatewayTransferId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_access_token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/{{api_prefix}}/payouts/{{payout_id}}/retry",
            "description": "Retries a failed or reversed payout. Requires an ADMIN token and a payout ID from MongoDB or failed webhook testing."
          },
          "response": [
            {
              "name": "Payout retry initiated",
              "originalRequest": {
                "method": "POST",
                "header": [],
