{
  "info": {
    "name": "EverCut - Onboarding",
    "description": "Customer and barber onboarding requests wired for the OTP test users and the local sample upload asset. Run 01-authentication.json first to populate onboarding tokens. Upon successful onboarding, access and refresh tokens are captured for the other collections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Default local API server"
    },
    {
      "key": "api_prefix",
      "value": "api/v1",
      "type": "string",
      "description": "API prefix used by every request"
    },
    {
      "key": "customer_access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token - auto-set by 01-authentication.json for returning users or by 02-onboarding.json after first-time signup"
    },
    {
      "key": "barber_access_token",
      "value": "",
      "type": "string",
      "description": "JWT access token - auto-set by 01-authentication.json for returning users or by 02-onboarding.json after first-time signup"
    },
    {
      "key": "customer_onboarding_token",
      "value": "",
      "type": "string",
      "description": "Short-lived onboarding JWT - auto-set by 01-authentication.json when a new customer is detected"
    },
    {
      "key": "barber_onboarding_token",
      "value": "",
      "type": "string",
      "description": "Short-lived onboarding JWT - auto-set by 01-authentication.json when a new barber is detected"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const readScopedValue = (...keys) => {",
          "  for (const key of keys) {",
          "    const environmentValue = pm.environment.get(key);",
          "    if (environmentValue) return environmentValue;",
          "    const globalValue = pm.globals.get(key);",
          "    if (globalValue) return globalValue;",
          "  }",
          "  return '';",
          "};",
          "const syncScopedValue = (sourceKey, collectionKey = sourceKey) => {",
          "  const scopedValue = readScopedValue(sourceKey);",
          "  if (scopedValue) {",
          "    pm.collectionVariables.set(collectionKey, scopedValue);",
          "  }",
          "};",
          "syncScopedValue('base_url');",
          "syncScopedValue('api_prefix');",
          "const customerToken = readScopedValue('customer_access_token');",
          "if (customerToken) { pm.collectionVariables.set('customer_access_token', customerToken); }",
          "const barberToken = readScopedValue('barber_access_token');",
          "if (barberToken) { pm.collectionVariables.set('barber_access_token', barberToken); }",
          "const customerOnboardingToken = readScopedValue('customer_onboarding_token');",
          "if (customerOnboardingToken) { pm.collectionVariables.set('customer_onboarding_token', customerOnboardingToken); }",
          "const barberOnboardingToken = readScopedValue('barber_onboarding_token');",
          "if (barberOnboardingToken) { pm.collectionVariables.set('barber_onboarding_token', barberOnboardingToken); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Complete Customer Profile",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/onboarding/customers",
        "description": "Creates the customer profile for the OTP-verified customer test user. A rerun returns 409 because onboarding only succeeds once per account.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "firstName",
              "value": "Test",
              "type": "text"
            },
            {
              "key": "lastName",
              "value": "Customer",
              "type": "text"
            },
            {
              "key": "phoneNumber",
              "value": "9876543210",
              "type": "text"
            },
            {
              "key": "email",
              "value": "test.customer@example.com",
              "type": "text"
            },
            {
              "key": "gender",
              "value": "Male",
              "type": "text"
            },
            {
              "key": "dateOfBirth",
              "value": "1994-06-15",
              "type": "text"
            },
            {
              "key": "address",
              "value": "Church Street, Bengaluru",
              "type": "text"
            },
            {
              "key": "location",
              "value": "{\"type\":\"Point\",\"coordinates\":[77.5946,12.9716]}",
              "type": "text",
              "description": "GeoJSON point near the barber test shop"
            },
            {
              "key": "photo",
              "type": "file",
              "src": "/Users/prankitapotbhare/Projects/EverCut/server/postman-collections/assets/sample-upload.png",
              "description": "Prewired local sample upload"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_onboarding_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201 or 409', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
              "const response = pm.response.code === 201 ? pm.response.json() : null;",
              "const data = response && response.data ? response.data : {};",
              "if (pm.response.code === 201) {",
              "  if (data.accessToken) {",
              "    pm.collectionVariables.set('customer_access_token', data.accessToken);",
              "    pm.environment.set('customer_access_token', data.accessToken);",
              "  }",
              "  if (data.refreshToken) {",
              "    pm.collectionVariables.set('customer_refresh_token', data.refreshToken);",
              "    pm.environment.set('customer_refresh_token', data.refreshToken);",
              "  }",
              "  pm.collectionVariables.set('customer_onboarding_token', '');",
              "  pm.environment.set('customer_onboarding_token', '');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Complete Barber Profile",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/onboarding/barbers",
        "description": "Creates the barber shop for the OTP-verified barber test user. The three shop image fields already point to the local sample file.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "firstName",
              "value": "Test",
              "type": "text"
            },
            {
              "key": "lastName",
              "value": "Barber",
              "type": "text"
            },
            {
              "key": "email",
              "value": "test.barber@example.com",
              "type": "text"
            },
            {
              "key": "dateOfBirth",
              "value": "1991-01-12",
              "type": "text"
            },
            {
              "key": "gender",
              "value": "Male",
              "type": "text"
            },
            {
              "key": "shopName",
              "value": "Postman Test Barber Studio",
              "type": "text"
            },
            {
              "key": "shopOwner",
              "value": "Test Barber",
              "type": "text"
            },
            {
              "key": "businessCategory",
              "value": "Barber",
              "type": "text"
            },
            {
              "key": "targetCustomers",
              "value": "male",
              "type": "text"
            },
            {
              "key": "shopLocation",
              "value": "MG Road, Bengaluru",
              "type": "text"
            },
            {
              "key": "location",
              "value": "{\"type\":\"Point\",\"coordinates\":[77.5946,12.9716]}",
              "type": "text",
              "description": "Matches the customer discovery coordinates"
            },
            {
              "key": "amenities",
              "value": "[\"Air Conditioning\",\"Waiting Area\",\"Drinking Water\",\"Washrooms\",\"Parking Area\",\"Wi-Fi\",\"Charging Points\"]",
              "type": "text"
            },
            {
              "key": "workingDays",
              "value": "[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"]",
              "type": "text"
            },
            {
              "key": "workingHours",
              "value": "{\"opensAt\":\"09:00\",\"closesAt\":\"20:00\"}",
              "type": "text"
            },
            {
              "key": "breakTimings",
              "value": "[{\"startsAt\":\"13:00\",\"endsAt\":\"14:00\"}]",
              "type": "text"
            },
            {
              "key": "accountHolderName",
              "value": "Test Barber",
              "type": "text"
            },
            {
              "key": "bankName",
              "value": "HDFC Bank",
              "type": "text"
            },
            {
              "key": "upiAddress",
              "value": "test.barber@upi",
              "type": "text"
            },
            {
              "key": "pin",
              "value": "1234",
              "type": "text"
            },
            {
              "key": "confirmPin",
              "value": "1234",
              "type": "text"
            },
            {
              "key": "shopImages",
              "type": "file",
              "src": "/Users/prankitapotbhare/Projects/EverCut/server/postman-collections/assets/sample-upload.png",
              "description": "Sample shop image 1 of 3"
            },
            {
              "key": "shopImages",
              "type": "file",
              "src": "/Users/prankitapotbhare/Projects/EverCut/server/postman-collections/assets/sample-upload.png",
              "description": "Sample shop image 2 of 3"
            },
            {
              "key": "shopImages",
              "type": "file",
              "src": "/Users/prankitapotbhare/Projects/EverCut/server/postman-collections/assets/sample-upload.png",
              "description": "Sample shop image 3 of 3"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{barber_onboarding_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201 or 409', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
              "const response = pm.response.code === 201 ? pm.response.json() : null;",
              "const data = response && response.data ? response.data : {};",
              "const shopId = data.shop && data.shop._id;",
              "if (shopId) { pm.globals.set('shared_shop_id', shopId); }",
              "if (pm.response.code === 201) {",
              "  if (data.accessToken) {",
              "    pm.collectionVariables.set('barber_access_token', data.accessToken);",
              "    pm.environment.set('barber_access_token', data.accessToken);",
              "  }",
              "  if (data.refreshToken) {",
              "    pm.collectionVariables.set('barber_refresh_token', data.refreshToken);",
              "    pm.environment.set('barber_refresh_token', data.refreshToken);",
              "  }",
              "  pm.collectionVariables.set('barber_onboarding_token', '');",
              "  pm.environment.set('barber_onboarding_token', '');",
              "  pm.globals.set('shared_barber_pin', '1234');",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
