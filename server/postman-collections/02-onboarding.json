{
  "info": {
    "name": "EverCut - Onboarding",
    "description": "Customer and barber onboarding requests wired for the OTP test users and the local sample upload asset. Run 01-authentication.json first to populate onboarding tokens. Shop schedule fields accept HH:MM or hh:mm AM/PM input and are normalized to 24-hour storage. Upon successful onboarding, access and refresh tokens are captured for the other collections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Default local API server"
    },
    {
      "key": "api_prefix",
      "value": "api/v1",
      "type": "string",
      "description": "API prefix used by every request"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    }
  ],
  "item": [
    {
      "name": "1. Complete Customer Profile",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/onboarding/customers",
        "description": "Creates the customer for the OTP-verified customer test user. A rerun returns 409 because onboarding only succeeds once per account.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "firstName",
              "value": "Test",
              "type": "text"
            },
            {
              "key": "lastName",
              "value": "Customer",
              "type": "text"
            },
            {
              "key": "phoneNumber",
              "value": "9876543210",
              "type": "text"
            },
            {
              "key": "email",
              "value": "test.customer@example.com",
              "type": "text"
            },
            {
              "key": "gender",
              "value": "Male",
              "type": "text"
            },
            {
              "key": "dateOfBirth",
              "value": "1994-06-15",
              "type": "text"
            },
            {
              "key": "address",
              "value": "Church Street, Bengaluru",
              "type": "text"
            },
            {
              "key": "location",
              "value": "{\"type\":\"Point\",\"coordinates\":[77.5946,12.9716]}",
              "type": "text",
              "description": "GeoJSON point near the barber test shop"
            },
            {
              "key": "photo",
              "type": "file",
              "description": "Attach customer photo file manually in Postman"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_onboarding_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 201 or 409', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json().data || {};",
              "  if (data.accessToken) pm.environment.set('customer_access_token', data.accessToken);",
              "  if (data.refreshToken) pm.environment.set('customer_refresh_token', data.refreshToken);",
              "  pm.environment.unset('customer_onboarding_token');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Complete Barber Profile",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/onboarding/barbers",
        "description": "Creates the barber shop for the OTP-verified barber test user. Shop schedule values can be sent in HH:MM or hh:mm AM/PM format and are normalized by the backend. The three shop image fields already point to the local sample file.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "firstName",
              "value": "Test",
              "type": "text"
            },
            {
              "key": "lastName",
              "value": "Barber",
              "type": "text"
            },
            {
              "key": "email",
              "value": "test.barber@example.com",
              "type": "text"
            },
            {
              "key": "dateOfBirth",
              "value": "1991-01-12",
              "type": "text"
            },
            {
              "key": "gender",
              "value": "Male",
              "type": "text"
            },
            {
              "key": "shopName",
              "value": "Postman Test Barber Studio",
              "type": "text"
            },
            {
              "key": "shopOwner",
              "value": "Test Barber",
              "type": "text"
            },
            {
              "key": "businessCategory",
              "value": "Barber",
              "type": "text"
            },
            {
              "key": "targetCustomers",
              "value": "male",
              "type": "text"
            },
            {
              "key": "shopLocation",
              "value": "MG Road, Bengaluru",
              "type": "text"
            },
            {
              "key": "location",
              "value": "{\"type\":\"Point\",\"coordinates\":[77.5946,12.9716]}",
              "type": "text",
              "description": "Matches the customer discovery coordinates"
            },
            {
              "key": "amenities",
              "value": "[\"Air Conditioning\",\"Waiting Area\",\"Drinking Water\",\"Washrooms\",\"Parking Area\",\"Wi-Fi\",\"Charging Points\"]",
              "type": "text"
            },
            {
              "key": "workingDays",
              "value": "[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"]",
              "type": "text"
            },
            {
              "key": "workingHours",
              "value": "{\"opensAt\":\"09:00\",\"closesAt\":\"20:00\"}",
              "type": "text"
            },
            {
              "key": "breakTimings",
              "value": "[{\"startsAt\":\"13:00\",\"endsAt\":\"14:00\"}]",
              "type": "text"
            },
            {
              "key": "accountHolderName",
              "value": "Test Barber",
              "type": "text"
            },
            {
              "key": "bankName",
              "value": "HDFC Bank",
              "type": "text"
            },
            {
              "key": "upiAddress",
              "value": "test.barber@upi",
              "type": "text"
            },
            {
              "key": "pin",
              "value": "1234",
              "type": "text"
            },
            {
              "key": "confirmPin",
              "value": "1234",
              "type": "text"
            },
            {
              "key": "shopImages",
              "type": "file",
              "description": "Attach shop image 1 of 3 manually in Postman"
            },
            {
              "key": "shopImages",
              "type": "file",
              "description": "Attach shop image 2 of 3 manually in Postman"
            },
            {
              "key": "shopImages",
              "type": "file",
              "description": "Attach shop image 3 of 3 manually in Postman"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{barber_onboarding_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 201 or 409', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json().data || {};",
              "  if (data.shop && data.shop._id) pm.globals.set('shared_shop_id', data.shop._id);",
              "  if (data.accessToken) pm.environment.set('barber_access_token', data.accessToken);",
              "  if (data.refreshToken) pm.environment.set('barber_refresh_token', data.refreshToken);",
              "  pm.environment.unset('barber_onboarding_token');",
              "  pm.globals.set('shared_barber_pin', '1234');",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
