        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/bookings/{{booking_id_status}}",
        "description": "Updates the captured booking status. Use `booking_id_status`, not the delete-only booking ID.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
