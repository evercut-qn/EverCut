        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/bookings?status=confirmed",
        "description": "Lists confirmed bookings. Paid bookings move through awaiting_confirmation before barber confirmation."
      },
      "event": [
        {
