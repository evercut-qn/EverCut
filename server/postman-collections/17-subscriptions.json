{
  "info": {
    "name": "EverCut - Subscriptions",
    "description": "Barber subscription lifecycle collection covering plan listing, Razorpay subscription checkout, upgrade/downgrade, cancellation, transactions, and webhook simulation. Run authentication and onboarding first to capture barber_access_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{barber_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically pull IDs from Globals ONLY if user hasn't manually set them in Collection Variables.",
          "const syncGlobalToCollection = (globalKey, collectionKey = globalKey) => {",
          "  const globalVal = pm.globals.get(globalKey);",
          "  const collVal = pm.collectionVariables.get(collectionKey);",
          "  if (globalVal && !collVal) {",
          "    pm.collectionVariables.set(collectionKey, globalVal);",
          "  }",
          "};",
          "syncGlobalToCollection('barber_profile_id', 'barber_profile_id');",
          "syncGlobalToCollection('razorpay_subscription_id', 'razorpay_subscription_id');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Default local API server"
    },
    {
      "key": "api_prefix",
      "value": "api/v1",
      "type": "string",
      "description": "API prefix used by every request"
    },
    {
      "key": "subscription_plan_id",
      "value": "PLAN_POPULAR",
      "type": "string",
      "description": "Plan to subscribe to or downgrade to. Use PLAN_POPULAR or PLAN_ADVANCED for paid plans."
    },
    {
      "key": "subscription_upgrade_plan_id",
      "value": "PLAN_ADVANCED",
      "type": "string",
      "description": "Plan used by the upgrade request."
    },
    {
      "key": "subscription_downgrade_plan_id",
      "value": "PLAN_POPULAR",
      "type": "string",
      "description": "Plan used by the downgrade request."
    },
    {
      "key": "razorpay_subscription_id",
      "value": "sub_postman_123",
      "type": "string",
      "description": "Razorpay subscription id used in webhook examples."
    },
    {
      "key": "razorpay_plan_id_popular",
      "value": "plan_test_popular",
      "type": "string",
      "description": "Razorpay Popular plan id for webhook examples."
    },
    {
      "key": "razorpay_plan_id_advanced",
      "value": "plan_test_advanced",
      "type": "string",
      "description": "Razorpay Advanced plan id for webhook examples."
    },
    {
      "key": "razorpay_webhook_secret",
      "value": "",
      "type": "string",
      "description": "Webhook secret configured in Razorpay dashboard and server env."
    },
    {
      "key": "barber_profile_id",
      "value": "",
      "type": "string",
      "description": "Mongo Barber _id used in Razorpay notes for local webhook simulations."
    }
  ],
  "item": [
    {
      "name": "1. List Plans",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/subscriptions/plans",
        "description": "Public plan catalog with pricing and entitlement limits.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "  if (response.meta !== undefined) pm.expect(response.meta).to.be.an('object');",
              "  const responseText = JSON.stringify(response);",
              "  ['\"$__\"', '\"_doc\"', '\"$isNew\"', '\"__v\"', '\"parent\"', '\"populated\"'].forEach((field) => {",
              "    pm.expect(responseText, `internal field ${field} must not appear`).to.not.include(field);",
              "  });",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const response = pm.response.json();",
              "pm.test('three plans returned', function () { pm.expect(response.data.map((p) => p.id)).to.include.members(['PLAN_BASIC', 'PLAN_POPULAR', 'PLAN_ADVANCED']); });"
            ]
          }
        }
      ]
    },
