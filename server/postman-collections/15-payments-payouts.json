{
  "info": {
    "name": "EverCut - Payments & Payouts",
    "description": "Native PhonePe SDK payment initiation/verification, webhook simulation with automatic signature generation, refund processing, and payout retry for the EverCut dual-provider payment system. PhonePe is used for customer collection; Cashfree Payouts is used for barber disbursement. Webhook requests include pre-request scripts that automatically compute cryptographic signatures (SHA256 for PhonePe, HMAC-SHA256 for Cashfree) using environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customer_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically pull IDs from Globals ONLY if user hasn't manually set them in Collection Variables.",
          "const syncGlobalToCollection = (globalKey, collectionKey = globalKey) => {",
          "  const globalVal = pm.globals.get(globalKey);",
          "  const collVal = pm.collectionVariables.get(collectionKey);",
          "  if (globalVal && !collVal) {",
          "    pm.collectionVariables.set(collectionKey, globalVal);",
          "  }",
          "};",
          "syncGlobalToCollection('shared_booking_id', 'payment_booking_id');",
          "syncGlobalToCollection('payment_id', 'payment_id');",
          "syncGlobalToCollection('merchant_order_id', 'merchant_order_id');",
          "syncGlobalToCollection('merchant_refund_id', 'merchant_refund_id');",
          "syncGlobalToCollection('refund_id', 'refund_id');",
          "syncGlobalToCollection('payout_id', 'payout_id');",
          "syncGlobalToCollection('payout_transfer_id', 'payout_transfer_id');",
          "syncGlobalToCollection('admin_access_token', 'admin_access_token');",
          "syncGlobalToCollection('phonepe_webhook_username', 'phonepe_webhook_username');",
          "syncGlobalToCollection('phonepe_webhook_password', 'phonepe_webhook_password');",
          "syncGlobalToCollection('cashfree_webhook_secret', 'cashfree_webhook_secret');",
          "// Ensure payment_booking_id is synced ONLY if it hasn't been set manually.",
          "const currentPaymentBookingId = pm.collectionVariables.get('payment_booking_id');",
          "if (!currentPaymentBookingId) {",
          "  const bookingId = pm.globals.get('shared_booking_id') || pm.globals.get('booking_id');",
          "  if (bookingId) {",
          "    pm.collectionVariables.set('payment_booking_id', bookingId);",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Default local API server"
    },
    {
      "key": "api_prefix",
      "value": "api/v1",
      "type": "string",
      "description": "API prefix used by every request"
    },
    {
      "key": "admin_access_token",
      "value": "",
      "type": "string",
      "description": "Required for payout retry. Use a JWT for a user whose role is ADMIN."
    },
    {
      "key": "payment_booking_id",
      "value": "",
      "type": "string",
      "description": "Booking ID for payment - auto-synced from shared_booking_id or booking_id"
    },
    {
      "key": "payment_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from payment initiation"
    },
    {
      "key": "merchant_order_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from payment initiation"
    },
    {
      "key": "merchant_refund_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from refund initiation"
    },
    {
      "key": "refund_id",
      "value": "",
      "type": "string",
      "description": "Auto-captured from refund initiation"
    },
    {
      "key": "payout_id",
      "value": "",
      "type": "string",
      "description": "Payout ID for retry operations"
    },
    {
      "key": "payout_transfer_id",
      "value": "",
      "type": "string",
      "description": "Payout transfer ID from MongoDB - required for payout webhook simulation"
    },
    {
      "key": "phonepe_webhook_username",
      "value": "test-phonepe-webhook-user",
      "type": "string",
      "description": "PhonePe webhook username - must match PHONEPE_WEBHOOK_USERNAME in .env"
    },
    {
      "key": "phonepe_webhook_password",
      "value": "test-phonepe-webhook-password",
      "type": "string",
      "description": "PhonePe webhook password - must match PHONEPE_WEBHOOK_PASSWORD in .env"
    },
    {
      "key": "cashfree_webhook_secret",
      "value": "test-cashfree-client-secret",
      "type": "string",
      "description": "Cashfree webhook secret - must match CASHFREE_PAYOUT_CLIENT_SECRET in .env"
    }
  ],
  "item": [
    {
      "name": "1. Create Native SDK Payment Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/payments",
        "description": "Creates a PhonePe native SDK checkout order for the authenticated customer's pending booking. The response returns id, orderId, token, merchantId, and merchantOrderId for the Flutter PhonePe SDK. No redirect URL is returned.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"{{payment_booking_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_access_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "  if (response.meta !== undefined) pm.expect(response.meta).to.be.an('object');",
              "  const responseText = JSON.stringify(response);",
              "  ['\"$__\"', '\"_doc\"', '\"$isNew\"', '\"__v\"', '\"parent\"', '\"populated\"'].forEach((field) => {",
              "    pm.expect(responseText, `internal field ${field} must not appear`).to.not.include(field);",
              "  });",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('captures native payment references', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response.success).to.equal(true);",
              "  pm.expect(response.data).to.have.property('id');",
              "  pm.expect(response.data).to.have.property('merchantOrderId');",
              "  pm.expect(response.data).to.have.property('orderId');",
              "  pm.expect(response.data).to.have.property('token');",
              "  pm.expect(response.data).to.have.property('merchantId');",
              "  pm.expect(response.data).to.not.have.property('redirectUrl');",
              "  pm.collectionVariables.set('payment_id', response.data.id);",
              "  pm.collectionVariables.set('merchant_order_id', response.data.merchantOrderId);",
              "  pm.globals.set('payment_id', response.data.id);",
              "  pm.globals.set('merchant_order_id', response.data.merchantOrderId);",
              "});"
            ]
          }
        }
      ]
    },
