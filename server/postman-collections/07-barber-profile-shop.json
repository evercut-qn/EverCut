{
  "info": {
    "name": "EverCut - Barber Profile & Shop",
    "description": "Barber profile and shop management collection. Uses the barber JWT access token captured by 01-authentication.json for returning users or by 02-onboarding.json after first-time signup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{barber_access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically pull IDs from Globals ONLY if user hasn't manually set them in Collection Variables.",
          "const syncGlobalToCollection = (globalKey, collectionKey = globalKey) => {",
          "  const globalVal = pm.globals.get(globalKey);",
          "  const collVal = pm.collectionVariables.get(collectionKey);",
          "  if (globalVal && !collVal) {",
          "    pm.collectionVariables.set(collectionKey, globalVal);",
          "  }",
          "};",
          "syncGlobalToCollection('shared_shop_id', 'shop_id');",
          "syncGlobalToCollection('shared_barber_pin', 'barber_active_pin');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Default local API server"
    },
    {
      "key": "api_prefix",
      "value": "api/v1",
      "type": "string",
      "description": "API prefix used by every request"
    },
    {
      "key": "shop_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "barber_active_pin",
      "value": "1234",
      "type": "string"
    },
    {
      "key": "barber_next_pin",
      "value": "5678",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get Profile And Capture Shop ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/shops/me",
        "description": "Reads the barber profile and stores the current shop ID for the dependent collections."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "const response = pm.response.json();",
              "const shopId = response.data && response.data._id;",
              "if (shopId) { pm.collectionVariables.set('shop_id', shopId); pm.globals.set('shared_shop_id', shopId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Update Business Info",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/shops/me",
        "description": "Updates the barber profile using the onboarding-friendly request shape that the backend validators actually accept. NOTE: Email updates must use PUT /account/email endpoint.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"Barber\",\n  \"shopOwner\": \"Test Barber\",\n  \"dateOfBirth\": \"1991-01-12\",\n  \"gender\": \"Male\",\n  \"shopName\": \"Postman Test Barber Studio\",\n  \"businessCategory\": \"Barber\",\n  \"targetCustomers\": \"male\",\n  \"shopLocation\": \"MG Road, Bengaluru\",\n  \"location\": {\"type\":\"Point\",\"coordinates\":[77.5946,12.9716]},\n  \"amenities\": [\"Air Conditioning\", \"Waiting Area\", \"Parking Area\", \"Wi-Fi\"],\n  \"workingDays\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"],\n  \"workingHours\": {\n    \"opensAt\": \"09:00\",\n    \"closesAt\": \"20:00\"\n  },\n  \"breakTimings\": [\n    {\n      \"startsAt\": \"13:00\",\n      \"endsAt\": \"14:00\"\n    }\n  ],\n  \"accountHolderName\": \"Test Barber\",\n  \"bankName\": \"HDFC Bank\",\n  \"upiAddress\": \"test.barber@upi\",\n  \"bio\": \"Updated from the automated Postman profile collection.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get UPI Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/shops/me/upi",
        "description": "Reads the dedicated UPI payload."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update UPI Details",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/shops/me/upi",
        "description": "Updates only the dedicated payment fields.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountHolderName\": \"Test Barber\",\n  \"bankName\": \"HDFC Bank\",\n  \"upiAddress\": \"test.barber+verified@upi\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Ensure Shop Is Open",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/{{api_prefix}}/shops/me/status",
        "description": "Explicitly opens the shop so customer discovery and bookings can run immediately after this collection.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response).to.have.property('success');",
              "  pm.expect(response.success).to.be.a('boolean');",
              "  pm.expect(response).to.have.property('message');",
              "  pm.expect(response.message).to.be.a('string');",
              "  pm.expect(response).to.have.property('data');",
              "});",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Update Profile Picture",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/shops/me/picture",
        "description": "Uploads or replaces the owner profile picture.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "photo",
              "type": "file",
              "description": "Attach profile picture file manually in Postman"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('response uses the standard envelope', function () {",
