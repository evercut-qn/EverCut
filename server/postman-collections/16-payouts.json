    },
    {
      "name": "5. Retry Failed Cashfree Payout",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/{{api_prefix}}/payouts/{{payout_id}}/retry",
        "description": "**Description:** Retries a failed or reversed Cashfree payout. Requires an ADMIN token and a payout ID for a legacy/automatic Cashfree payout.\n\n**Auth Role:** Admin\n\n**Prerequisites:** `admin_access_token`, `payout_id`\n\n**Captured Variables:** None"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const requestUrl = pm.request.url.toString();",
              "const resolvedUrl = pm.variables.replaceIn(requestUrl);",
